[Unit]
Description=V7LTHRONYX restricted privileged helper
After=network.target
Before=vpn-panel.service

[Service]
Type=simple
User=root
Group=root
# /opt/v7lthronyx must be root-owned (install.sh: secure_install_tree): this
# root service imports code from it. No EnvironmentFile: .env belongs to the
# panel user, and LD_PRELOAD or PYTHONPATH in it would run as root.
WorkingDirectory=/opt/v7lthronyx
Environment="PANEL_USER=vpnpanel" "PANEL_GROUP=vpnpanel"
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/opt/v7lthronyx/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/v7lthronyx/venv/bin/python3 -m app.privileged_helper_daemon
Restart=on-failure
RestartSec=3
UMask=0027
RuntimeDirectory=v7lthronyx
RuntimeDirectoryMode=0751
StateDirectory=v7lthronyx

PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_NET_ADMIN CAP_NET_RAW
ReadWritePaths=-/run/v7lthronyx -/etc/v7lthronyx -/etc/letsencrypt -/etc/fail2ban -/etc/nginx -/usr/local/etc -/var/www -/var/log/nginx -/var/lib/nginx -/var/log/xray

[Install]
WantedBy=multi-user.target
