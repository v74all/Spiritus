[Unit]
Description=V7LTHRONYX VPN Management Panel
Documentation=https://github.com/v74all/Spiritus
After=network.target xray.service postgresql.service redis-server.service v7l-privileged-helper.service
Wants=xray.service v7l-privileged-helper.service

[Service]
Type=simple
# Run as a dedicated unprivileged user. Create with:
#   useradd --system --home-dir /opt/v7lthronyx --shell /usr/sbin/nologin vpnpanel
User=vpnpanel
Group=vpnpanel
WorkingDirectory=/opt/v7lthronyx
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/opt/v7lthronyx/venv/bin:/usr/local/bin:/usr/bin:/bin"
# Listen on all interfaces; use 127.0.0.1 only behind a reverse proxy.
ExecStart=/opt/v7lthronyx/venv/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 38471 --workers 2 --proxy-headers --forwarded-allow-ips='127.0.0.1'
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# ── Sandboxing ──
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
ReadWritePaths=/opt/v7lthronyx /usr/local/etc/xray /var/log/xray
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=v7lthronyx

[Install]
WantedBy=multi-user.target
